{
  "name": "binyleds-storyscape",
  "version": "1.0.0",
  "private": true,
  "description": "The Hugo website for Binyled\u2019s Storyscape.",
  "scripts": {
    "dev": "hugo server --buildDrafts --disableFastRender",
    "build": "node scripts/build-site.mjs",
    "export:tj": "python3 scripts/export-tj.py",
    "check": "bash scripts/check.sh",
    "build:cloudflare": "node scripts/build-cloudflare.mjs",
    "test:intake": "node --test tests/intake.test.mjs tests/intake-browser.test.mjs tests/site-browser.test.mjs",
    "test:hosting": "python3 scripts/check_cloudflare_build.py",
    "retry:notification": "node scripts/retry-notification.mjs",
    "inbox": "node scripts/inbox.mjs",
    "test:all": "npm run check && npm run test:intake && npm run test:hosting",
    "check:source": "node scripts/check-source.mjs",
    "build:remote": "SITE_PROFILE=remote node scripts/build-site.mjs",
    "session": "node scripts/session.mjs",
    "pretest:intake": "node scripts/check-runtime.mjs"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
